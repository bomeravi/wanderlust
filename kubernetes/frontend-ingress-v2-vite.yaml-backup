apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wanderlust-frontend-ingress
  namespace: wanderlust
  annotations:
    kubernetes.io/ingress.class: nginx
    cert-manager.io/cluster-issuer: letsencrypt-prod

    nginx.ingress.kubernetes.io/ssl-redirect: "true"

    # Websocket support (important for Vite HMR)
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"

    # Prevent large bundle issues
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"

spec:
  tls:
    - hosts:
        - wanderlust-frontend.digi.saroj.name.np
      secretName: wanderlust-frontend-tls

  rules:
    - host: wanderlust-frontend.digi.saroj.name.np
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend-service
                port:
                  number: 5173